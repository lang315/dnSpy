<Project Sdk="Microsoft.NET.Sdk">

  <!--
      Tier 2: drives a real dnSpy over HTTP. Nothing here references dnSpy's assemblies — the whole
      point is to exercise the running process, so the only contract is the MCP endpoint itself.
      Every test self-skips unless DNSPY_MCP_TEST_URL is set, so `dotnet test` across the repo stays
      green on a machine with no dnSpy running. Use tests/run-integration.ps1 to set it up.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- The HTTP/JSON-RPC plumbing is identical to Tier 1; share it rather than forking it. -->
    <Compile Include="..\dnSpy.MCP.Tests\Rpc.cs" Link="Rpc.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
